{
  "expo": {
    "name": "mobile-firetruck-expo",
    "slug": "mobile-firetruck-expo",
    "scheme": "mobilefiretruckexpo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bfp.mobilefiretruckexpo"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.bfp.mobilefiretruckexpo",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "INTERNET",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "BLUETOOTH",
        "BLUETOOTH_CONNECT"
      ],
      "notification": {
        "icon": "./assets/adaptive-icon.png",
        "color": "#B71C1C"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "./plugins/withTwilioVoice",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "expo-font",
      "expo-notifications"
    ],
    "owner": "tzuntzun",
    "extra": {
      "eas": {
        "projectId": "1bd5c5c0-62b0-4d49-819b-b540d09bbefa"
      }
    }
  }
}
