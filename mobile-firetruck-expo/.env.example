# Expo only exposes env vars prefixed with EXPO_PUBLIC_
# Set this to your deployed backend base URL.
EXPO_PUBLIC_BASE_URL=https://api.example.com

# Supabase project values used by src/utils/supabaseClient.ts
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Map rendering key for WebView + Leaflet tiles
EXPO_PUBLIC_MAPTILER_API_KEY=your-maptiler-api-key
